<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bracket.vfs-vsock-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/Chevalier/bin/portproxy-darwin-vsock-bridge</string>
    <string>--vsock-port</string>
    <string>13339</string>
    <string>--listen-address</string>
    <string>127.0.0.1:18080</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>1</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/Chevalier/vfs-vsock-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Chevalier/vfs-vsock-bridge.log</string>
</dict>
</plist>
