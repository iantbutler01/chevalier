# syntax=docker/dockerfile:1.7
# Chevalier VMD image — the Nym computer substrate as a container.
#
# Build context is the chevalier REPO ROOT (not sandbox/): the vmd crate depends
# on the sibling workspace crate ../../hash, so the context must contain both
# `hash/` and `sandbox/`. Root .dockerignore allowlists exactly what's needed.
#
#   docker build -f sandbox/Dockerfile.vmd -t chevalier-vmd:dev .
#
# Runtime contract (see OtherYou infra/docker-compose.yml `vmd` service):
#   --privileged, /dev/kvm + /dev/fuse, host docker.sock (d2vm image builds),
#   state on /var/lib/chevalier/vms, listens on 0.0.0.0:18072.
#
# @dive-rel: Same bill of materials as the OVH systemd deployment (vmd + patched
# @dive-rel: virtiofsd 1.13 + envoy + coredns + d2vm + portproxy guest bins).

ARG D2VM_SOURCE_IMAGE=linkacloud/d2vm:latest
ARG ENVOY_IMAGE=envoyproxy/envoy:v1.33.0
ARG COREDNS_IMAGE=coredns/coredns:1.12.1

FROM rust:1.90-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    git \
    libssl-dev \
    make \
    protobuf-compiler \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Preserve the on-disk layout so vmd's `path = "../../hash"` dependency and the
# workspace [patch] entries (patches/fuser-0.17.0) resolve exactly as they do in
# a checkout. Building from the workspace root means sandbox/Cargo.lock — the
# lockfile local `cargo build -p vmd` uses — governs the image too.
WORKDIR /src
COPY hash ./hash
COPY sandbox/Cargo.toml sandbox/Cargo.lock ./sandbox/
COPY sandbox/vmd ./sandbox/vmd
COPY sandbox/crates ./sandbox/crates
COPY sandbox/proto ./sandbox/proto
COPY sandbox/portproxy ./sandbox/portproxy
COPY sandbox/patches/fuser-0.17.0 ./sandbox/patches/fuser-0.17.0

WORKDIR /src/sandbox
# Cache mounts keep the registry and the ~400-crate target dir across builds so
# a source edit is an incremental rebuild, not a from-scratch release build.
# Cache mounts are not part of the image; copy the artifacts out in-step.
RUN --mount=type=cache,id=vmd-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=vmd-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=vmd-target,target=/src/sandbox/target \
    cargo build --release -p vmd --bin vmd --bin vmdctl \
    && mkdir -p /out \
    && cp target/release/vmd target/release/vmdctl /out/

# @dive-rel: virtiofsd 1.13+ is required for vhost-user migration cooperation (the
# @dive-rel: VHOST_USER_PROTOCOL_F_LOG_SHMFD feature bit and `--migration-mode=find-paths`).
# @dive-rel: Ubuntu 24.04 apt ships 1.10 which predates migration support; build from
# @dive-rel: crates.io in a separate Cargo stage so the final image gets a migrate-capable
# @dive-rel: binary at /usr/libexec/virtiofsd.
FROM rust:1.90-bookworm AS vfsd-builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    curl \
    libcap-ng-dev \
    libseccomp-dev \
    patch \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY sandbox/patches/virtiofsd-1.13.0-lock-forwarding.patch /src/patches/virtiofsd-1.13.0-lock-forwarding.patch
COPY sandbox/scripts/build-patched-virtiofsd.sh /src/scripts/build-patched-virtiofsd.sh
RUN --mount=type=cache,id=vfsd-cargo-registry,target=/usr/local/cargo/registry \
    VIRTIOFSD_INSTALL_ROOT=/usr/local \
    VIRTIOFSD_SKIP_TESTS=1 \
    /src/scripts/build-patched-virtiofsd.sh

FROM ubuntu:26.04 AS threat-feed-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gawk \
    && rm -rf /var/lib/apt/lists/*
COPY sandbox/vmd/assets/threat-domains.seed.hosts /tmp/threat-domains.seed.hosts
RUN set -eux; \
    curl -fsSL https://urlhaus.abuse.ch/downloads/hostfile/ -o /tmp/urlhaus.hosts || cp /tmp/threat-domains.seed.hosts /tmp/urlhaus.hosts; \
    curl -fsSL https://isc.sans.edu/feeds/suspiciousdomains_High.txt -o /tmp/sans-high.txt || cp /tmp/threat-domains.seed.hosts /tmp/sans-high.txt; \
    cat /tmp/threat-domains.seed.hosts /tmp/urlhaus.hosts /tmp/sans-high.txt \
      | sed 's/\r$//' \
      | awk '/^[[:space:]]*#/ || /^[[:space:]]*$/ { next } /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+[[:space:]]+/ { print $2; next } { print $1 }' \
      | awk 'NF' \
      | sort -u \
      | awk '{print "0.0.0.0 " $1}' \
      > /tmp/threat-domains.hosts

FROM --platform=linux/amd64 ${D2VM_SOURCE_IMAGE} AS d2vm
FROM --platform=linux/amd64 ${ENVOY_IMAGE} AS envoy-bin
FROM --platform=linux/amd64 ${COREDNS_IMAGE} AS coredns-bin

# @dive-rel: Ubuntu 26.04 ships QEMU 10.x, which includes mapped-ram file
# @dive-rel: migration. vmd uses mapped-ram + direct-io for new RAM
# @dive-rel: snapshots so warm restores do not get stuck on the old sequential
# @dive-rel: `-incoming file:` path.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    cryptsetup-bin \
    docker.io \
    dosfstools \
    e2fsprogs \
    extlinux \
    fdisk \
    fuse3 \
    iproute2 \
    iptables \
    kpartx \
    parted \
    qemu-efi-aarch64 \
    qemu-system-arm \
    qemu-system-x86 \
    qemu-utils \
    util-linux \
    virtiofsd \
    && rm -rf /var/lib/apt/lists/*

RUN if getent group qemu >/dev/null; then \
      groupmod --gid 1000 qemu; \
    elif getent group 1000 >/dev/null; then \
      group_name="$(getent group 1000 | cut -d: -f1)"; \
      groupmod --new-name qemu "$group_name"; \
    else \
      groupadd --gid 1000 qemu; \
    fi \
    && if id -u qemu >/dev/null 2>&1; then \
      usermod --uid 1000 --gid 1000 --home /home/qemu --shell /usr/sbin/nologin qemu; \
    elif getent passwd 1000 >/dev/null; then \
      user_name="$(getent passwd 1000 | cut -d: -f1)"; \
      usermod --login qemu --move-home --home /home/qemu --gid 1000 --shell /usr/sbin/nologin "$user_name"; \
    else \
      useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin qemu; \
    fi

COPY --from=d2vm /usr/local/bin/d2vm /usr/local/bin/d2vm
COPY --from=builder /out/vmd /usr/local/bin/vmd
COPY --from=builder /out/vmdctl /usr/local/bin/vmdctl
COPY --from=envoy-bin /usr/local/bin/envoy /usr/local/bin/envoy
COPY --from=coredns-bin /coredns /usr/local/bin/coredns
COPY --from=threat-feed-builder /tmp/threat-domains.hosts /opt/chevalier/network/threat-domains.hosts
# Overwrite the Ubuntu-shipped virtiofsd 1.10 with our source-built 1.13.0 that
# supports `--migration-mode` / VHOST_USER_PROTOCOL_F_LOG_SHMFD.
COPY --from=vfsd-builder /usr/local/bin/virtiofsd /usr/libexec/virtiofsd
COPY sandbox/portproxy/bin/portproxy-linux-amd64 /opt/chevalier/portproxy/bin/portproxy-linux-amd64
COPY sandbox/portproxy/bin/portproxy-linux-arm64 /opt/chevalier/portproxy/bin/portproxy-linux-arm64

RUN chmod +x /usr/local/bin/vmd \
    /usr/local/bin/vmdctl \
    /usr/local/bin/envoy \
    /usr/local/bin/coredns \
    /usr/libexec/virtiofsd \
    /opt/chevalier/portproxy/bin/portproxy-linux-amd64 \
    /opt/chevalier/portproxy/bin/portproxy-linux-arm64 \
    && chmod 0644 /opt/chevalier/network/threat-domains.hosts

ENV PROXY_BIN=/opt/chevalier/portproxy/bin
VOLUME ["/var/lib/chevalier/vms"]
EXPOSE 18072
ENTRYPOINT ["vmd"]
CMD ["--listen", "0.0.0.0:18072", "--data-dir", "/var/lib/chevalier/vms"]
